SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:////data/myapp/app.db
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FORCE_HTTPS=true
APP_HOSTNAME=myapp.example.com,www.myapp.example.com   # comma-separated allow-list
VERSION=1.0.0
# PASSKEY_RP_ID=myapp.example.com   # domain passkeys belong to; defaults to the first APP_HOSTNAME. Must be a name, not an IP: use localhost in development
# PASSKEY_RP_NAME=My App            # name shown when a user creates a passkey
# FLASK_PORT=5000   # assign a unique dev port per app — see port registry in PATTERNS.md. Omit in production.
# TEST_USER=alice   # bypass Google OAuth in local dev; logs in as fake user 'alice'
